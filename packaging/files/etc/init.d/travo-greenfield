#!/bin/sh /etc/rc.common
# shellcheck shell=sh
# Starts the travo-greenfield daemon under procd. Settings: /etc/config/travo-greenfield, section main.
# shellcheck disable=SC2034 # rc.common reads these variables
START=99
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	# shellcheck disable=SC3043 # ash supports local; rc.common scripts use it
	local enabled listen static_dir host_allow release_source
	# shellcheck disable=SC1091 # rc.common provides config_load, not present on the dev machine
	config_load travo-greenfield
	config_get enabled main enabled 1
	[ "$enabled" = 0 ] && return 0
	config_get listen main listen '0.0.0.0:8090'
	config_get static_dir main static_dir '/www/travo-greenfield'
	config_get host_allow main host_allow ''
	config_get release_source main release_source ''

	procd_open_instance
	procd_set_param command /usr/bin/travo-greenfield --listen "$listen" --static-dir "$static_dir"
	[ -n "$host_allow" ] && procd_append_param command --host-allow "$host_allow"
	[ -n "$release_source" ] && procd_append_param command --release-source "$release_source"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
