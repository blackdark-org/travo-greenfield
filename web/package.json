{
  "name": "travo-greenfield-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "openapi-ts",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "dev": "vite",
    "build": "vite build && node scripts/gzip-dist.mjs",
    "check": "biome check . && svelte-check --tsconfig ./tsconfig.json && vitest run && pnpm build && node scripts/size-budget.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@hey-api/openapi-ts": "0.99.0",
    "@inlang/paraglide-js": "3.2.1",
    "@inlang/plugin-message-format": "4.5.0",
    "@lucide/svelte": "1.70.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
